###############################################################################
# ServiceDesk Pro — environment configuration
# Copy this file to `.env` at the repository root:   cp .env.example .env
# Everything below has a working default for local development, so the app boots
# with zero configuration. Never commit a real `.env`.
###############################################################################

# ─────────────────────────────── Runtime ────────────────────────────────────
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
# Comma-separated extra allowed CORS origins (CLIENT_URL is always allowed).
CORS_EXTRA_ORIGINS=

# ─────────────────────────────── Database ───────────────────────────────────
# Point this at a local mongod, a Docker container, or MongoDB Atlas.
#   local:  mongodb://127.0.0.1:27017/servicedesk_pro
#   atlas:  mongodb+srv://<user>:<pass>@<cluster>/servicedesk_pro?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/servicedesk_pro

# If no MongoDB is reachable, "auto" boots an in-process MongoDB
# (mongodb-memory-server) instead. Its data is held in memory and discarded when
# the process exits, so the server re-seeds it with demo data on every boot.
# Handy on a fresh clone; never used in production. For data that persists, run a
# real mongod, point MONGO_URI at it, and seed it once with `npm run seed`.
USE_IN_MEMORY_DB=auto     # auto | true | false   ("auto" = fall back if MONGO_URI fails)

# ──────────────────────────────── Auth ──────────────────────────────────────
# CHANGE THESE. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production while these dev values are in place.
JWT_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-fedcba9876543210
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10

# ───────────────────────── Demo mode / Time Machine ─────────────────────────
# DEMO_MODE=true enables the injectable DemoClock and the /api/demo endpoints
# (Time Machine, reseed). Forced off in production regardless of this value.
DEMO_MODE=true
DEMO_BANNER=true

# ──────────────────────────── SLA engine ────────────────────────────────────
# IANA timezone for all business-hours arithmetic.
BUSINESS_TIMEZONE=Asia/Kolkata
# How often (seconds) the SLA monitor sweeps for at-risk / breached tickets.
# The at-risk threshold and the per-priority budgets live on the SLA policy
# document, editable by an admin in the app.
SLA_MONITOR_INTERVAL_SECONDS=60

# ───────────────────────── Ticket suggestions ───────────────────────────────
# Leave AI_API_KEY empty to run fully offline: category/priority suggestions fall
# back to a deterministic keyword classifier, and the response says which was
# used. Suggestions are never applied automatically — a person confirms them.
AI_PROVIDER=auto                     # auto | anthropic | heuristic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS=800
AI_TIMEOUT_MS=15000
AI_ENABLED=true

# ─────────────────────────────── Uploads ───────────────────────────────────
# Local disk via multer. UPLOAD_DIR is relative to server/ unless absolute.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ────────────────────────────── Rate limits ────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=60

# ───────────────────────────── Observability ───────────────────────────────
LOG_LEVEL=info                       # trace | debug | info | warn | error
LOG_PRETTY=true

# ──────────────────────── Seed / demo credentials ──────────────────────────
# Used by `npm run seed`. A clearly documented development password — never use
# these credentials anywhere real.
SEED_PASSWORD=Passw0rd!
SEED_TICKET_COUNT=120
SEED_ASSET_COUNT=40
SEED_USER_COUNT=14
SEED_MONTHS_OF_HISTORY=3
